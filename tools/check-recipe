#!/bin/sh
# Roadmap Stage 7: the README's "Using zubin from C" recipe and the fixture
# package tools/zubintest agree line for line. Each fenced block that follows
# a `<!-- recipe: FILE -->` marker must equal FILE in the fixture (or, for
# `DESCRIPTION LinkingTo`, the fixture's LinkingTo line). Carriage returns are
# ignored, since a Windows checkout may convert line endings. Run from the root.
set -eu
fail=0
README=$(mktemp)
trap 'rm -f "$README"' EXIT
tr -d '\r' < README.md > "$README"
blocks=$(grep -c '^<!-- recipe: ' "$README")
[ "$blocks" -ge 5 ] || { echo "FAIL: only $blocks recipe blocks in README.md"; exit 1; }
for target in $(grep '^<!-- recipe: ' "$README" | sed 's/^<!-- recipe: //; s/ -->$//; s/ /:/'); do
    marker="<!-- recipe: $(echo "$target" | tr ':' ' ') -->"
    block=$(awk -v m="$marker" '
        $0 == m { found = 1; next }
        found && /^```/ { if (inside) exit; inside = 1; next }
        found && inside { print }
    ' "$README")
    case "$target" in
        DESCRIPTION:LinkingTo) want=$(grep '^LinkingTo' tools/zubintest/DESCRIPTION | tr -d '\r') ;;
        *) want=$(tr -d '\r' < "tools/zubintest/$target") ;;
    esac
    block=$(printf '%s\n' "$block" | tr -d '\r')
    if [ "$block" = "$want" ]; then
        echo "ok   $target"
    else
        echo "FAIL $target: the README block differs from the fixture"; fail=1
    fi
done
[ "$fail" -eq 0 ] && echo "recipe agrees with the fixture" || exit 1
